# Notion Integration secret (create one at https://www.notion.so/my-integrations)
NOTION_TOKEN=replace-with-your-notion-integration-secret
# Database ID of your "Blog Posts" database (the 32-char hex in your shared URL)
NOTION_DATABASE_ID=replace-with-your-notion-database-id
# Optional: port for the API server
PORT=8787

# QR product platform (set Firebase values in Vercel and Firebase Functions)
PUBLIC_BASE_URL=https://devonyx.in
QR_CODE_PEPPER=replace-with-a-random-secret-at-least-32-characters
REQUIRE_APP_CHECK=false
# Firebase Web API key for Firebase Authentication in the admin QR batch screen.
# This is a public browser key; restrict it to the required APIs and site domains.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
# Optional local admin-claim script: service account JSON, kept server-side only.
# The deployed Firebase Function uses its attached service identity instead.
FIREBASE_SERVICE_ACCOUNT=

# Public marketplace URLs: leave blank until real listings are available.
VITE_QR_AMAZON_URL=
VITE_QR_FLIPKART_URL=
VITE_QR_MEESHO_URL=
